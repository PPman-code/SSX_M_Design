{
  "name": "ssx-mobile-design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.17.0 <23" },
  "scripts": {
    "dev": "vite --port 5178 --strictPort",
    "dev:lan": "vite --host 0.0.0.0 --port 5178 --strictPort",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm check:generated && pnpm typecheck && pnpm lint",
    "build": "pnpm generate:tokens && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5178 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss-value-parser": "4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
